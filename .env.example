# Private extraction API (server repository ICEA-POC). No Azure credentials belong here.
# Only this URL changes between local and remote use:
#   local server container on the shared Docker network: http://icea-uat-api:8000
#   POC server through the SSH tunnel on this machine:   http://host.docker.internal:8083
#     (open the tunnel first: ssh -N -L 8083:127.0.0.1:8083 <user>@<server-host>;
#      the client runs in Docker, so the host's 127.0.0.1 is host.docker.internal)
ICEA_API_URL=
ICEA_API_TOKEN=
# Client-side timeout for one HTTP request (server processing plus upload)
ICEA_API_TIMEOUT_SECONDS=600
# Docker network shared with a local API container (created by scripts/uat.ps1 if missing)
ICEA_API_DOCKER_NETWORK=icea-api
